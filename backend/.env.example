APP_NAME=Astra AI Platform
APP_ENV=development
APP_VERSION=0.6.0
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080"]
CORS_ORIGIN_REGEX=https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?
CORS_ALLOW_PRIVATE_NETWORK=true

POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_dev_password
POSTGRES_DB=astra_ai
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=3

JWT_SECRET_KEY=development-only-change-this-secret-before-shared-use-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=roleplay-engine
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

CHAT_CONTEXT_MESSAGE_LIMIT=50
CHAT_MAX_MESSAGE_LENGTH=12000
CHAT_DEFAULT_TEMPERATURE=0.8
CHAT_DEFAULT_MAX_TOKENS=2048
CHAT_STREAM_HEARTBEAT_SECONDS=15
CONVERSATION_PAGE_SIZE_MAX=100
RUN_MIGRATIONS=true

PLATFORM_SYSTEM_PROMPT=You are Astra AI. Follow the active character and persona context without inventing actions or dialogue for the user.
MEMORY_CONTEXT_LIMIT=12
MEMORY_MIN_IMPORTANCE=0.2

RAG_CHUNK_SIZE_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=240
RAG_DEFAULT_TOP_K=5
TOOL_EXECUTION_TIMEOUT_SECONDS=15
